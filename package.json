{
  "name": "hatsally-fajr-alarm",
  "version": "5.1.0",
  "private": true,
  "description": "هتصلي يعني هتصلي - منبه الفجر الذكي (PWA + تطبيق أندرويد APK أصلي)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "export:android": "CAPACITOR_EXPORT=true next build",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "build:apk": "CAPACITOR_EXPORT=true next build && rm -f out/downloads/hatsally.apk && npx cap sync android",
    "apk:assemble": "cd android && ./gradlew assembleDebug",
    "test:vision": "npx tsx scripts/vision-test.ts"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@vladmandic/face-api": "^1.7.15",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.43.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "^4.23.13",
    "youtube-transcript": "^1.3.1",
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "sharp": "^0.35.4",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
