<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/alarm_lock_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lock_badge"
                android:textColor="#F87171"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_ghost"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </LinearLayout>

        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/ic_app_badge"
            android:contentDescription="@string/app_name"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/alarm_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_primary_dark"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/alarm_time_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fajr_sub"
            android:textColor="@color/text_muted_dark"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/alarm_stage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/stage_gentle"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp" />

        <TextView
            android:id="@+id/alarm_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_muted_dark"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="30dp">

            <View android:id="@+id/v1" android:layout_width="4dp" android:layout_height="26dp" android:background="@color/stage_gentle" android:layout_marginEnd="3dp" />
            <View android:id="@+id/v2" android:layout_width="4dp" android:layout_height="20dp" android:background="@color/stage_gentle" android:layout_marginEnd="3dp" />
            <View android:id="@+id/v3" android:layout_width="4dp" android:layout_height="32dp" android:background="@color/stage_gentle" android:layout_marginEnd="3dp" />
            <View android:id="@+id/v4" android:layout_width="4dp" android:layout_height="16dp" android:background="@color/stage_gentle" android:layout_marginEnd="3dp" />
            <View android:id="@+id/v5" android:layout_width="4dp" android:layout_height="28dp" android:background="@color/stage_gentle" android:layout_marginEnd="3dp" />
            <View android:id="@+id/v6" android:layout_width="4dp" android:layout_height="22dp" android:background="@color/stage_gentle" android:layout_marginEnd="3dp" />
            <View android:id="@+id/v7" android:layout_width="4dp" android:layout_height="34dp" android:background="@color/stage_gentle" android:layout_marginEnd="3dp" />
            <View android:id="@+id/v8" android:layout_width="4dp" android:layout_height="18dp" android:background="@color/stage_gentle" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_woke"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="34dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:text="@string/btn_woke"
            android:textColor="#06120F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_snooze"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_ghost"
            android:gravity="center"
            android:text="@string/hold_snooze"
            android:textColor="@color/text_muted_dark"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/snooze_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="6dp" />
    </LinearLayout>
</FrameLayout>
